{
  "productName": "Tsukishita",
  "version": "0.1.0",
  "identifier": "com.tsukishita.moonlight",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:4173/",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "月下祓行",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "url": "http://127.0.0.1:4173/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../server-bundle/game.js",
      "../server-bundle/index.html",
      "../server-bundle/styles.css",
      "../server-bundle/items-data.js",
      "../server-bundle/progression-data.js",
      "../server-bundle/chest-data.js",
      "../server-bundle/vendor/three.module.js",
      "../server-bundle/suzu.wav",
      "../server-bundle/suzu.aif",
      "../server-bundle/suzu-long.wav",
      "../server-bundle/suzu-long.aif",
      "../server-bundle/Battle.m4a",
      "../server-bundle/Battle.flac"
    ]
  }
}
